# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_PRIVY_APP_ID=        # from dashboard.privy.io; add your site's address under allowed origins
NEXT_PUBLIC_RPC_URL=             # a private devnet RPC (the public one rate-limits)
NEXT_PUBLIC_EVENT_ADDRESS=       # optional: open this event first
DEMO_MINT=                       # test token mint from `npm run setup-demo`, used by /api/drip
# Same address as DEMO_MINT; the app hides events priced in other tokens.
NEXT_PUBLIC_DEMO_MINT=
NEXT_PUBLIC_CHECK_BASE=          # optional, on a laptop dev server: public site gate QRs link to (phones can't open localhost)
NEXT_PUBLIC_EXTRA_GATE_ORIGINS=  # optional, on the public site: other sites whose gate codes it accepts, e.g. http://localhost:3000 (devnet demo only)
# Server-only. Lets usernames follow the Privy (email) account; from the Privy dashboard, App settings.
PRIVY_APP_SECRET=
